# 复制为 backend/.env 后按需修改（.env 不提交）
APP_NAME=云东AI购
API_PREFIX=/api/v1

# MySQL 8（默认）
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=yd_ai_shop

# 可选：直接给连接串。留空则用上面的 MySQL 配置拼
# 没有 MySQL 时可用 SQLite 先跑通骨架：sqlite:///./dev.db
DB_URL=

# 鉴权
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 大模型网关（Day2 用，兼容 OpenAI 协议，默认通义 DashScope）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 前端静态目录（相对 backend 目录）
FRONTEND_DIR=../frontend
